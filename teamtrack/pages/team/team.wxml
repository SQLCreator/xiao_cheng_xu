<!--pages/team/team.wxml-->
<view class="page theme-{{theme}}">
  <!-- 队伍信息卡片 -->
  <view class="team-card" wx:if="{{team}}">
    <view class="team-header-row">
      <view class="team-badge-lg">{{team.name[0] || 'T'}}</view>
      <view class="flex-1">
        <text class="team-name-lg">{{team.name}}</text>
        <text class="text-sm text-secondary">{{team.categoryText}}</text>
      </view>
      <view class="switch-team-btn" bindtap="goTeamsPage">切换</view>
    </view>
    <view class="team-desc text-sm text-secondary">{{team.description}}</view>
    <view class="team-meta">
      <view class="team-meta-item">
        <text class="meta-label text-xs text-secondary">成员数</text>
        <text class="meta-value text-orange">{{team.memberCount}}</text>
      </view>
      <view class="team-meta-item">
        <text class="meta-label text-xs text-secondary">完成度</text>
        <text class="meta-value text-green">{{team.progress}}%</text>
      </view>
      <view class="team-meta-item">
        <text class="meta-label text-xs text-secondary">截止日期</text>
        <text class="meta-value text-blue">{{team.deadline}}</text>
      </view>
    </view>
  </view>

  <!-- 无队伍提示 -->
  <view wx:if="{{!loading && !team}}" class="empty-team">
    <text class="text-secondary">还没有{{scene.teamLabel}}，去创建或加入一个吧</text>
    <view class="empty-team-btns">
      <navigator url="/pages/createTeam/createTeam" class="empty-btn primary">{{scene.createLabel}}</navigator>
      <navigator url="/pages/teams/teams" class="empty-btn">团队管理</navigator>
    </view>
  </view>

  <!-- 时间线 -->
  <view class="section" wx:if="{{team}}">
    <view class="section-header">
      <text class="section-title">{{scene.timelineLabel}}</text>
      <text wx:if="{{isCaptain}}" class="text-xs text-secondary">点击设置进度</text>
    </view>
    <view class="timeline">
      <view wx:for="{{timeline}}" wx:key="step"
        class="timeline-item {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}} {{isCaptain ? 'clickable' : ''}}"
        bindtap="onTimelineTap" data-step="{{item.step}}" data-title="{{item.title}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-step text-sm text-secondary">步骤 {{item.step}}</text>
          <text class="timeline-title">{{item.title}}</text>
          <text class="timeline-date text-xs text-secondary">{{item.statusText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成员列表 -->
  <view class="section" wx:if="{{team}}">
    <view class="section-header">
      <text class="section-title">{{scene.teamLabel}}成员</text>
      <view class="member-head-actions">
        <text wx:if="{{isCaptain}}" class="recalc-link" bindtap="onRecalcStats">重算统计</text>
        <button class="invite-btn" open-type="share">邀请成员</button>
      </view>
    </view>
    <view class="member-list">
      <view wx:for="{{members}}" wx:key="_id" class="member-item"
        bindtap="goMemberDetail" data-item="{{item}}">
        <view class="member-avatar">{{item.nickName[0]}}</view>
        <view class="flex-1">
          <view class="flex gap-sm align-center">
            <text class="member-name">{{item.nickName}}</text>
            <view class="tag {{item.role === 'captain' ? 'tag-orange' : (item.role === 'guest' ? 'tag-yellow' : 'tag-blue')}}">{{item.role === 'captain' ? scene.ownerLabel : (item.role === 'guest' ? '外部协作' : scene.memberLabel)}}</view>
          </view>
          <text class="text-xs text-secondary">{{scene.contributionLabel}} {{item.contribution}} · 完成 {{item.completedTasks}} 个任务</text>
        </view>
        <view class="member-progress">
          <view class="member-progress-bar">
            <view class="member-progress-fill" style="width: {{item.percentage}}%;"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 邀请码 -->
  <view class="section" wx:if="{{team}}">
    <view class="invite-card">
      <view class="invite-info">
        <text class="invite-title">{{scene.inviteLabel}}</text>
        <text class="invite-code">{{inviteCode}}</text>
      </view>
      <view class="invite-action" bindtap="copyCode">
        <text>复制</text>
      </view>
    </view>
    <view class="join-team-btn" bindtap="onJoinTeam">
      <text>通过邀请码加入其他{{scene.teamLabel}}</text>
    </view>
  </view>

  <!-- 报表导出（仅负责人可见） -->
  <view class="section" wx:if="{{team && isCaptain}}">
    <view class="export-row" bindtap="onExport">
      <view class="flex-1">
        <text class="export-title">导出团队报表</text>
        <text class="text-xs text-secondary">任务清单 / 成员贡献 / 本周周报（CSV，可用 Excel 打开）</text>
      </view>
      <text class="export-arrow">›</text>
    </view>
  </view>

  <!-- 入队审批（仅负责人可见） -->
  <view class="section" wx:if="{{team && isCaptain}}">
    <view class="section-header">
      <text class="section-title">入队审批</text>
      <view class="join-mode-box">
        <text class="text-xs text-secondary">需审批</text>
        <switch checked="{{joinMode === 'approval'}}" color="#FF6B35" bindchange="onToggleJoinMode" />
      </view>
    </view>

    <block wx:if="{{joinRequests.length > 0}}">
      <view wx:for="{{joinRequests}}" wx:key="_id" class="join-request">
        <view class="member-avatar">{{item.nickName[0]}}</view>
        <view class="flex-1">
          <text class="member-name">{{item.nickName}}</text>
          <text class="text-xs text-secondary">申请加入{{scene.teamLabel}}</text>
        </view>
        <view class="req-btn req-btn-reject" catchtap="onRejectJoin" data-id="{{item._id}}">拒绝</view>
        <view class="req-btn req-btn-pass" catchtap="onApproveJoin" data-id="{{item._id}}">通过</view>
      </view>
    </block>
    <view wx:else class="empty-mini">暂无待审批申请</view>
  </view>

  <view class="bottom-space"></view>
</view>