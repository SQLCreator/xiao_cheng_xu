/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 32rpx;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), var(--info));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 0 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--border);
  position: relative;
}

.ps-arrow {
  position: absolute;
  right: 24rpx;
  font-size: 32rpx;
  color: var(--text-dim);
}

.ps-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ps-num {
  font-size: 44rpx;
  font-weight: 700;
}

.ps-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--surface-strong);
}

.menu-section {
  margin: 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
}

.menu-title {
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 20rpx 28rpx 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--faint);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text);
}

.menu-count {
  font-size: 28rpx;
  background: var(--surface);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.menu-arrow {
  font-size: 36rpx;
}

.product-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
}

.mt-sm {
  margin-top: 8rpx;
}

/* 登录引导 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.login-avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--border);
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 28rpx;
  margin-bottom: 48rpx;
}

.login-btn {
  width: 60%;
}

/* 注册流程卡片 */
.register-prompt {
  padding-top: 120rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.register-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 56rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255, 107, 53, 0.2);
  box-shadow: 0 8rpx 40rpx rgba(255, 107, 53, 0.15);
}

.register-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), var(--info));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.3);
}

.register-title {
  color: var(--text);
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.register-desc {
  font-size: 26rpx;
  margin-bottom: 32rpx;
  text-align: center;
  line-height: 1.5;
}

.register-input {
  width: 100%;
  background: var(--card-2);
  border-radius: 16rpx;
  padding: 24rpx;
  color: var(--text);
  font-size: 28rpx;
  border: 1rpx solid var(--border);
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.edit-icon {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-left: 8rpx;
}

/* 主题切换（日间 / 夜间） */
.theme-switch {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: var(--card-2);
  border-radius: 24rpx;
  padding: 4rpx;
  border: 1rpx solid var(--border);
}

.theme-opt {
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  transition: all 0.2s ease;
}

.theme-opt.active {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 53, 0.3);
}